# Public browser configuration only. Never place service-role keys, database
# credentials, market-data secrets, or other privileged values in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public Google OAuth client ID (not the client secret). Enables the direct
# Google Identity Services button; the existing Supabase redirect remains a fallback.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Keep true until Supabase and the authenticated cloud repository are ready.
NEXT_PUBLIC_DEMO_MODE=true

# Required before public launch for canonical URLs and privacy requests.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4173
NEXT_PUBLIC_PRIVACY_CONTACT=
